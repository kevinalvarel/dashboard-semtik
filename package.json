{
  "name": "admin-semtik",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "go -C backend run main.go",
    "dev:frontend": "npm --prefix frontend run dev",
    "build": "go -C backend build && npm --prefix frontend run build",
    "start": "go -C backend run main.go"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  },
  "dependencies": {
    "better-auth": "^1.6.23"
  }
}
